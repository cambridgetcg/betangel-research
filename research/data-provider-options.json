  "collector_contract": {
    "timestamps": {
      "event_time": "When the reported event occurred or forecast applies; nullable when unknown",
      "published_at": "Source-asserted publication of this item/version; never assumed receipt",
      "first_seen_at": "Provider-asserted first detection when documented; nullable",
      "received_at": "Actual local receipt of this version",
      "revised_at": "Source-asserted revision time; nullable",
      "revision_received_at": "Actual local observation of changed version",
      "analysis_completed_at": "Actual completion for the exact input versions analyzed"
    },
    "availability_rule": "No earlier than version receipt, explicit entity-link known_at, and analysis completion; all clocks retain timezone and precision",
    "versioning": "append_only; original_source_id, canonical_url, payload_hash, schema_version, collector/model/prompt/code/config versions",
    "identity": "Explicit course/date/race/runner links with evidence and known_at; ambiguous names abstain",
    "dedupe": "Canonical URL and permitted metadata fingerprint; separately versioned syndication cluster",
    "claims": "Separate verified facts, attributed allegations, opinion and uncertain extraction; corrections remain linked",
    "coverage": ["request_status", "query_version", "query_window", "pagination_complete", "result_cap_reached", "rate_limited", "source_outage", "empty_result_not_no_news"],
