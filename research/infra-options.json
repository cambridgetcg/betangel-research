{
  "schema_version": 1,
  "as_of": "2026-10-10",
  "status": "cost_comparison_preceded_direct_feed_deployment",
  "currency": "USD",
  "recommendation": {
    "now": "Mac + SQLite single writer and durable outbox; validate sources and collection gaps first.",
    "when_continuity_needed": "One always-on Linux collector: Fly + volume + object archive, or Lightsail + S3 for AWS consolidation.",
    "when_managed_database_needed": "Add managed Postgres only for concurrent writers, remote applications or concrete operational need. Fly + Supabase Storage can remain two providers.",
    "defer": [
      "Multi-vendor stack by default",
      "Fargate/SQS/EventBridge unless independent workers justify them",
      "Windows Bet Angel hosting decision"
    ]
  },
  "workload": {
    "days": 30,
    "hours": 720,
    "continuous_workers": 1,
    "news_sources": 10,
    "poll_interval_minutes": 5,
    "polls_per_month": 86400,
    "assumed_seconds_per_function_poll": 2,
    "assumed_function_memory_gb": 0.5,
    "function_gb_seconds": 86400,
    "average_metadata_db_gb": 2,
    "persistent_local_allocation_gb": 10,
    "average_raw_archive_gb": 50,
    "average_billable_snapshot_gb": 10,
    "object_class_a_requests": 10000,
    "object_class_b_requests": 100000,
    "internet_egress_gb": 20,
    "logs_ingested_gb": 1,
    "secrets": 3,
    "secret_api_calls": 10000,
    "note": "Illustrative unmeasured workload. 50GB is average stored compressed archive, not daily growth. Separate-function polling assumes one invocation per source per poll. Snapshot bytes reflect retained versions, not automatically volume size."
  },
  "cost_boundary": {
    "promotional_credits_used": false,
    "free_tier_allowances_used": false,
    "normal_purchased_plan_allowances_used": [
      "Supabase Pro recurring $10 compute allowance",
      "Supabase Pro included database disk, Storage and egress"
    ],
    "exclusions": [
      "Tax/VAT",
      "Currency conversion",
      "Windows/Bet Angel licence",
      "Market-data and news licences/subscriptions",
      "Model inference",
      "Support and labour",
      "Unpriced backup/log/alert services and overages"
    ],
    "egress_handling": "20GB Fly internet egress modelled at listed Europe rate. Other paths remain destination- and allowance-dependent; unknown is not zero. Tigris egress-free policy applies only to Tigris side.",
    "unknown_rule": "Null means unresolved, never free. Known-lines subtotal is not a full monthly invoice."
  },
  "architecture": [
    {
      "role": "continuous_worker",
      "design": "Mac/Linux VM/Fly Machine/ECS service keeps outbound stream open; restart/reconnect/backoff, checkpoint, bounded buffers and gaps required. Feed permission is independent.",
      "sources": [
        "fly_autostart",
        "ecs_services"
      ]
    },
    {
      "role": "short_pollers",
      "design": "Same-worker timer initially. Ordinary Lambda max 900s; Managed Instances async path max 5400s. Supabase Edge is Deno/TypeScript, max 150s free / 400s paid wall clock and 2s CPU, 256MB. These bounded functions do not replace an indefinite Python collector.",
      "sources": [
        "lambda_limits",
        "supabase_functions",
        "supabase_limits",
        "supabase_cron"
      ]
    },
    {
      "role": "database_queue",
      "design": "SQLite/outbox first. Postgres/pgmq when Supabase is justified; SQS for decoupled AWS workers. Deduplication, durable acknowledgement and retries remain application responsibilities.",
      "sources": [
        "supabase_queues",
        "sqs_delivery"
      ]
    },
    {
      "role": "archive_backup",
      "design": "Compressed immutable raw objects outside Git, hashes and metadata in DB; restore test. Fly local volumes have no automatic replication. Supabase DB backup excludes Storage object contents.",
      "sources": [
        "fly_volumes",
        "supabase_backups"
      ]
    },
    {
      "role": "secrets_observability",
      "design": "Runtime provider secrets, restricted access, redact logs; monitor last receive, source age, gap duration, queue backlog, disk and cost. Fly metrics approximately 15 days with external alerting; choose logs retention explicitly.",
      "sources": [
        "fly_secrets",
        "fly_metrics",
        "supabase_vault",
        "aws_secrets_pricing",
        "cloudwatch"
      ]
    },
    {
      "role": "windows_separation",
      "design": "Bet Angel Windows desktop is a separate host/licence decision; Linux collection plan does not run it.",
      "sources": [
        "betangel_windows"
      ]
    }
  ],
